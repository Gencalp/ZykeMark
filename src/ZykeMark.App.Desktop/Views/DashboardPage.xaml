<Page x:Class="ZykeMark.App.Desktop.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Welcome Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" 
                           Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                <TextBlock Text="Overview of your benchmarking activity" FontSize="14" 
                           Foreground="{StaticResource ZykeTextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Quick Actions -->
            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <ui:CardAction Margin="0,0,8,0" Command="{Binding StartCommand}" IsChevronVisible="False">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Play24" FontSize="24" Foreground="{StaticResource ZykePrimaryBrush}"/>
                        <TextBlock Text="Start Session" FontWeight="SemiBold" Margin="0,8,0,4" 
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <TextBlock Text="Begin a new capture session" FontSize="11" 
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="4,0" Command="{Binding RefreshSessionsCommand}" IsChevronVisible="False">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="History24" FontSize="24" Foreground="{StaticResource ZykeAccentBrush}"/>
                        <TextBlock Text="View Sessions" FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <TextBlock Text="Browse captured sessions" FontSize="11" 
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="8,0,0,0" Command="{Binding ExportPdfCommand}" IsChevronVisible="False">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="24" Foreground="{StaticResource ZykeSuccessBrush}"/>
                        <TextBlock Text="Export Report" FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <TextBlock Text="Generate PDF report" FontSize="11" 
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardAction>
            </UniformGrid>

            <!-- Current Status -->
            <TextBlock Text="Current Status" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" 
                            Background="{StaticResource ZykeSurfaceAltBrush}" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Gauge24" FontSize="24" Foreground="{StaticResource ZykePrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Duration" FontSize="11" Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Last Session Summary Preview (only if sessions exist) -->
            <StackPanel Visibility="{Binding HasSessions, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,24">
                <TextBlock Text="Last Session" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
                <ui:Card>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastSessionGameName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LastSessionDate}" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                            <TextBlock Text="Avg FPS" FontSize="11" Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastSessionAvgFps}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource ZykeSuccessBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="P99 Frame Time" FontSize="11" Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastSessionP99}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource ZykeWarningBrush}"/>
                        </StackPanel>

                        <ui:Button Grid.Column="3" Content="View Details" Icon="{ui:SymbolIcon ArrowRight24}"
                                   Command="{Binding OpenFolderCommand}" Appearance="Secondary" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>
            </StackPanel>

            <!-- Getting Started Checklist -->
            <TextBlock Text="Getting Started Checklist" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card>
                <StackPanel>
                    <!-- Step 1 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" 
                                Background="{StaticResource ZykePrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="1" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enter process name or PID" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Specify the game or application to benchmark (e.g., 'game.exe' or PID)" FontSize="12" 
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" 
                                Background="{StaticResource ZykePrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="2" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ensure target window is focused" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Keep the game/application in focus for accurate capture. Background windows may affect results." FontSize="12" 
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 3 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" 
                                Background="{StaticResource ZykePrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="3" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start capture (recommended: 60+ seconds)" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Press Start or Ctrl+Enter. Longer captures provide more accurate statistics." FontSize="12" 
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 4 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" 
                                Background="{StaticResource ZykeAccentBrush}" Margin="0,0,12,0">
                            <TextBlock Text="!" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="VSync note" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Disable VSync for uncapped FPS measurement. Capped frame rates may hide performance issues." FontSize="12" 
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 5 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" 
                                Background="{StaticResource ZykePrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="4" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Review results and export" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="After stopping, view Live Session for metrics or press Ctrl+E to export a PDF report." FontSize="12" 
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
