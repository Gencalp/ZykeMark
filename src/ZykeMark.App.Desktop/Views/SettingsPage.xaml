<Page x:Class="ZykeMark.App.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800">
            <!-- Page Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" 
                           Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                <TextBlock Text="Configure ZykeMark preferences and defaults" FontSize="14" 
                           Foreground="{StaticResource ZykeTextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Capture Settings -->
            <TextBlock Text="Capture Settings" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default API" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Graphics API to use for capture" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Auto Detect"/>
                            <ComboBoxItem Content="DirectX 11"/>
                            <ComboBoxItem Content="DirectX 12"/>
                            <ComboBoxItem Content="Vulkan"/>
                            <ComboBoxItem Content="OpenGL"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Resolution" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Resolution to record in reports" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1">
                            <ComboBoxItem Content="1280x720"/>
                            <ComboBoxItem Content="1920x1080"/>
                            <ComboBoxItem Content="2560x1440"/>
                            <ComboBoxItem Content="3840x2160"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Preset" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Graphics preset to record in reports" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="2">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Ultra"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Capture Duration (seconds)" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Default duration for timed captures" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                        <ui:NumberBox Grid.Column="1" Value="60" Minimum="10" Maximum="3600" SpinButtonPlacementMode="Compact"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- PresentMon Settings -->
            <TextBlock Text="PresentMon Settings" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PresentMon Path" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Path to PresentMon executable (leave empty for auto-detect)" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="C:\Path\To\PresentMon.exe"
                                    Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:Button Grid.Column="1" Content="Browse" Icon="{ui:SymbolIcon FolderOpen24}" 
                                   Margin="8,0,0,0" Command="{Binding BrowsePresentMonPathCommand}"/>
                        <ui:Button Grid.Column="2" Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" 
                                   Margin="8,0,0,0" Command="{Binding ValidatePresentMonPathCommand}"
                                   Appearance="Secondary"/>
                    </Grid>
                    <Border Background="{StaticResource ZykeSurfaceAltBrush}" CornerRadius="4" Padding="12,8"
                            Visibility="{Binding ShowPresentMonValidation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding PresentMonValidationIcon}" FontSize="16" 
                                           Foreground="{Binding PresentMonValidationBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PresentMonValidationMessage}" FontSize="12"
                                       Foreground="{Binding PresentMonValidationBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Appearance Settings -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                            <TextBlock Text="Application color theme" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Keyboard Shortcuts -->
            <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Start/Stop Session"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource ZykeSurfaceAltBrush}" 
                                CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                            <TextBlock Text="Ctrl + Enter" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Export PDF Report"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource ZykeSurfaceAltBrush}" 
                                CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                            <TextBlock Text="Ctrl + E" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- About -->
            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12" 
                            Background="{StaticResource ZykePrimaryBrush}" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Gauge24" FontSize="32" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ZykeMark" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                        <TextBlock Text="Version 1.0.0" FontSize="12"
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                        <TextBlock Text="Benchmarking Tool for Game Performance Analysis" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
