<Application x:Class="ZykeMark.App.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:ZykeMark.App.Desktop.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      
      <!-- Converters -->
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      
      <!-- Brand Colors -->
      <SolidColorBrush x:Key="ZykePrimaryBrush" Color="#6B1FAD" />
      <SolidColorBrush x:Key="ZykeAccentBrush" Color="#FF751F" />
      <SolidColorBrush x:Key="ZykeBackgroundBrush" Color="#0A0A0A" />
      <SolidColorBrush x:Key="ZykeSurfaceBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="ZykeSurfaceAltBrush" Color="#252525" />
      <SolidColorBrush x:Key="ZykeBorderBrush" Color="#3D3D3D" />
      <SolidColorBrush x:Key="ZykeTextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ZykeTextSecondaryBrush" Color="#B3B3B3" />
      <SolidColorBrush x:Key="ZykeSuccessBrush" Color="#4CAF50" />
      <SolidColorBrush x:Key="ZykeWarningBrush" Color="#FF9800" />
      <SolidColorBrush x:Key="ZykeErrorBrush" Color="#F44336" />
      
      <!-- Spacing -->
      <Thickness x:Key="SmallSpacing">8</Thickness>
      <Thickness x:Key="MediumSpacing">16</Thickness>
      <Thickness x:Key="LargeSpacing">24</Thickness>
      
    </ResourceDictionary>
  </Application.Resources>
</Application>
