<ui:FluentWindow x:Class="ZykeMark.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:ZykeMark.App.Desktop.Views"
        Title="ZykeMark" Height="900" Width="1400" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding ToggleSessionCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportPdfCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid Background="{StaticResource ZykeBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="ZykeMark">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="ZykeMark" FontWeight="SemiBold" FontSize="14" 
                               VerticalAlignment="Center" Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                    <Border Background="{StaticResource ZykePrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Panel -->
            <Border Grid.Column="0" Background="{StaticResource ZykeSurfaceBrush}" 
                    BorderBrush="{StaticResource ZykeBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo/Brand Area -->
                    <Border Grid.Row="0" Padding="16" BorderBrush="{StaticResource ZykeBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{StaticResource ZykePrimaryBrush}">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="20" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ZykeMark" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ZykeTextPrimaryBrush}"/>
                                    <TextBlock Text="Benchmarking Tool" FontSize="11" Foreground="{StaticResource ZykeTextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1" Margin="8,16,8,8">
                        <ui:Button x:Name="NavDashboard" Content="Dashboard" Icon="{ui:SymbolIcon Home24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Click="NavDashboard_Click" Margin="0,0,0,4"/>
                        <ui:Button x:Name="NavLiveSession" Content="Live Session" Icon="{ui:SymbolIcon Play24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Click="NavLiveSession_Click" Margin="0,0,0,4"/>
                        <ui:Button x:Name="NavSessions" Content="Sessions" Icon="{ui:SymbolIcon History24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Click="NavSessions_Click" Margin="0,0,0,4"/>
                        <ui:Button x:Name="NavSettings" Content="Settings" Icon="{ui:SymbolIcon Settings24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Click="NavSettings_Click" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- Session Status Panel at bottom of nav -->
                    <Border Grid.Row="2" Padding="12" Background="{StaticResource ZykeSurfaceAltBrush}"
                            BorderBrush="{StaticResource ZykeBorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsSessionRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource ZykeSuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Session Active" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZykeSuccessBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding DurationText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ZykeTextPrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{StaticResource ZykeTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Command Bar -->
                <Border Grid.Row="0" Background="{StaticResource ZykeSurfaceBrush}" 
                        BorderBrush="{StaticResource ZykeBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Session Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="Start" Icon="{ui:SymbolIcon Play24}" 
                                       Command="{Binding StartCommand}" 
                                       Appearance="Primary" Margin="0,0,8,0"
                                       ToolTip="Start Capture (Ctrl+Enter)"/>
                            <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" 
                                       Command="{Binding EndCommand}" 
                                       Appearance="Danger" Margin="0,0,16,0"
                                       ToolTip="Stop Capture (Ctrl+Enter)"/>
                            
                            <Border Background="{StaticResource ZykeSurfaceAltBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Timer24" Foreground="{StaticResource ZykeTextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DurationText}" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{StaticResource ZykeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Process/Build Input -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Process" FontSize="10" Foreground="{StaticResource ZykeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ui:TextBox x:Name="ProcessNameTextBox" Width="180" PlaceholderText="Process name or PID..." 
                                            Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Build" FontSize="10" Foreground="{StaticResource ZykeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ui:TextBox Width="120" PlaceholderText="Build version..." 
                                            Text="{Binding BuildVersion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Export Actions -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon DocumentPdf24}" Content="Export PDF" 
                                       Command="{Binding ExportPdfCommand}" 
                                       ToolTip="Export PDF Report (Ctrl+E)" Margin="0,0,8,0"/>
                            <ui:Button Icon="{ui:SymbolIcon Folder24}" Content="Open Folder" 
                                       Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                            <ui:Button Icon="{ui:SymbolIcon Copy24}" 
                                       Command="{Binding CopyErrorCommand}" 
                                       ToolTip="Copy Diagnostics"
                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status/Error Banner -->
                <Border Grid.Row="1" Background="{Binding StatusBannerBackground}" Padding="16,8"
                        Visibility="{Binding ShowStatusBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                                   Foreground="{Binding StatusBannerForeground}" VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="2" Content="Copy diagnostics" Icon="{ui:SymbolIcon Copy24}" 
                                   Command="{Binding CopyErrorCommand}" Appearance="Secondary"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Page Content Frame -->
                <Frame Grid.Row="2" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
