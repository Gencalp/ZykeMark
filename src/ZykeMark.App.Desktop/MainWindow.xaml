<Window x:Class="ZykeMark.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZykeMark" Height="900" Width="1200" Background="#000000">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#6B1FAD" Grid.Column="0">
      <DockPanel Margin="12">
        <TextBlock Text="ZykeMark" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
        <TextBlock DockPanel.Dock="Bottom" Text="v1.0.0" Margin="0,0,0,8" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Background="#1E1E1E" Padding="12" CornerRadius="6">
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Status:" FontWeight="Bold" />
            <TextBlock Text=" " />
            <TextBlock Text="{Binding StatusText}" />
            <TextBlock Text="   |   Duration:" Margin="16,0,0,0" FontWeight="Bold" />
            <TextBlock Text=" " />
            <TextBlock Text="{Binding DurationText}" />
            <TextBlock Text="   |   Process:" Margin="16,0,0,0" FontWeight="Bold" />
            <TextBox Width="200" Margin="6,0,0,0" Text="{Binding ProcessName}" />
            <TextBlock Text="   Build:" Margin="12,0,0,0" FontWeight="Bold" />
            <TextBox Width="120" Margin="6,0,0,0" Text="{Binding BuildVersion}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Start Session" Command="{Binding StartCommand}" />
            <Button Content="End Session" Command="{Binding EndCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" />
            <Button Content="Copy details" Command="{Binding CopyErrorCommand}" Margin="12,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="0,12,0,12">
        <StackPanel>
          <TextBlock Text="Key Performance Metrics" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
          <UniformGrid Columns="3">
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Current FPS" FontSize="12" />
                <TextBlock Text="{Binding CurrentFps}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Avg FPS" FontSize="12" />
                <TextBlock Text="{Binding AvgFps}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="1% Low" FontSize="12" />
                <TextBlock Text="{Binding OnePercentLowFps}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="0.1% Low" FontSize="12" />
                <TextBlock Text="{Binding PointOnePercentLowFps}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Avg Frame Time" FontSize="12" />
                <TextBlock Text="{Binding AvgFrameTimeMs}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="P99 Frame Time" FontSize="12" />
                <TextBlock Text="{Binding P99FrameTimeMs}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Worst Frame Time" FontSize="12" />
                <TextBlock Text="{Binding WorstFrameTimeMs}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Avg CPU Frame Time" FontSize="12" />
                <TextBlock Text="{Binding AvgCpuFrameTimeMs}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#6B1FAD" BorderThickness="1" Margin="4" Padding="8">
              <StackPanel>
                <TextBlock Text="Avg GPU Frame Time" FontSize="12" />
                <TextBlock Text="{Binding AvgGpuFrameTimeMs}" FontSize="20" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border BorderBrush="#FF751F" BorderThickness="1" Margin="0,12,0,0" Padding="8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Stutter >= 50ms:" FontWeight="Bold" />
              <TextBlock Text=" " />
              <TextBlock Text="{Binding Stutter50Count}" />
              <TextBlock Text="   Stutter >= 100ms:" Margin="16,0,0,0" FontWeight="Bold" />
              <TextBlock Text=" " />
              <TextBlock Text="{Binding Stutter100Count}" />
            </StackPanel>
          </Border>

          <Border BorderBrush="#333333" BorderThickness="1" Margin="0,12,0,0" Padding="12">
            <TextBlock Text="Sparkline (placeholder)" Foreground="#888888" />
          </Border>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#333333" BorderThickness="1" Padding="12" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Verdict" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="{Binding VerdictSummary}" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#333333" BorderThickness="1" Padding="12" Grid.Column="1" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="Next Steps" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="{Binding NextStepsSummary}" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#1E1E1E" Padding="12" CornerRadius="6">
        <DockPanel>
          <TextBlock Text="Session Folder:" />
          <TextBlock Text=" " />
          <TextBlock Text="{Binding SessionFolder}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" />
            <Button Content="Open Session Folder" Command="{Binding OpenFolderCommand}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
